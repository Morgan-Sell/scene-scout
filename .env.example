# Copy this file to .env and fill in values.
# Never commit .env to version control.

# Set to "true" to run the full pipeline without sending email
DRY_RUN=true

# LLM provider (LiteLLM — change model only, no code changes)
# LLM_MODEL=claude-sonnet-4-6
# LLM_API_KEY=
# LLM_API_BASE=          # Optional — for Ollama or custom endpoints

# Event platform APIs (Phase 1B.3 / 1C.3 / 1C.7)
# EVENTBRITE_API_TOKEN=          # Eventbrite — inactive until working search endpoint
# TICKETMASTER_API_KEY=          # Ticketmaster Discovery API (active in feeds.yaml)
#
# UAT defaults when no persisted profile (Phase 1C)
# UAT_HOME_CITY=New York
# UAT_HORIZON_DAYS=14

# Web UI (docker-compose web service)
# WEB_PASSWORD=

# Email delivery (Resend — Phase 7)
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=
# USER_EMAIL=
# USER_NAME=Friend
# TRACKING_BASE_URL=http://localhost:7860
