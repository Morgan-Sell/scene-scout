# Copy this file to .env and fill in values.
# Never commit .env to version control.

# Set to "true" to run the full pipeline without sending email
DRY_RUN=true

# LLM provider (LiteLLM — change model only, no code changes)
# LLM_MODEL=claude-sonnet-4-6
# LLM_API_KEY=
# LLM_API_BASE=          # Optional — for Ollama or custom endpoints

# Gradio web UI (docker-compose web service)
# GRADIO_PASSWORD=

# Email delivery (Milestone 5)
# SENDGRID_API_KEY=
# FROM_EMAIL=
# TO_EMAIL=
