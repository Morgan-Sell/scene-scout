# Copy this file to .env and fill in values.
# Never commit .env to version control.

# Set to "true" to run the full pipeline without sending email
DRY_RUN=true

# LLM provider (LiteLLM — change model only, no code changes)
# LLM_MODEL=claude-sonnet-4-6
# LLM_API_KEY=
# LLM_API_BASE=          # Optional — for Ollama or custom endpoints

# Event platform APIs (Phase 1B.3 / 1C.3 — inactive slots in config/feeds.yaml)
# EVENTBRITE_API_TOKEN=          # Eventbrite — feed inactive until working search endpoint
# TICKETMASTER_API_KEY=          # Ticketmaster — placeholder; adapter TBD
# SEATGEEK_CLIENT_ID=            # SeatGeek — placeholder; adapter TBD
# SONGKICK_API_KEY=              # Songkick — placeholder; adapter TBD
#
# Default metro for UAT / feed-probe when no profile is saved:
# UAT_HOME_CITY=New York

# Web UI (docker-compose web service)
# WEB_PASSWORD=

# Email delivery (Resend — Phase 7)
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=
# USER_EMAIL=
# USER_NAME=Friend
# UAT_HOME_CITY=New York
# UAT_HORIZON_DAYS=14
# TRACKING_BASE_URL=http://localhost:7860
